{
  "name": "samarkhand-hotel",
  "version": "1.0.0",
  "private": true,
  "description": "Samarkhand Hotel — public website, booking inquiry platform and admin CMS.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "assets:generate": "node scripts/generate-assets.mjs",
    "admin:hash": "node scripts/hash-password.mjs",
    "db:seed": "node scripts/seed-supabase.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "photos:fetch": "node scripts/fetch-photos.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-autoplay": "8.5.1",
    "embla-carousel-react": "8.5.1",
    "jose": "5.9.6",
    "lucide-react": "0.469.0",
    "next": "^15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.5": true
  }
}
