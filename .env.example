# =============================================================================
# Samarkhand Hotel — environment template
#
# Copy to `.env.local` for development, or paste the values into your hosting
# provider's environment settings for a deployment.
#
#   cp .env.example .env.local
#
# This file contains NAMES AND DESCRIPTIONS ONLY. Never commit real
# credentials to it, and never commit `.env.local` — `.gitignore` already
# excludes it.
#
# The application starts with none of these set: it runs in demo mode, serves
# the seeded content, and says so in the UI. Each block below turns one
# capability on.
# =============================================================================


# -----------------------------------------------------------------------------
# Site URL
#
# Used for canonical links, the sitemap and Open Graph tags. Without it the
# app falls back to the Vercel-provided URL, then to http://localhost:3000.
# No trailing slash.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Database + auth: Supabase
#
# Setting BOTH of these switches the app from demo mode to Supabase mode:
# real Postgres, real auth, real persistence.
#
# The anon key is sent to the browser by design. It is safe because Row Level
# Security governs what it can read and write — see supabase/migrations/.
# It is NOT a secret, and it is NOT an access control on its own.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: bypasses Row Level Security completely.
#
# Required only for media uploads and the seed script. Treat it like a root
# password: server-side only, never prefixed with NEXT_PUBLIC_, never checked
# into source control. Leaving it unset disables uploads and says so in the
# admin rather than failing at the point of use.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Admin access in demo mode
#
# Only used when Supabase is NOT configured. With Supabase, accounts live in
# Supabase Auth and the `profiles` table decides who is staff.
#
# There is no default administrator and no fallback password. If these are
# unset, the admin area simply cannot be signed into — which is correct for a
# deployment nobody has provisioned.
#
# Generate the hash and the session secret with:
#
#   npm run admin:hash
#
# It reads the password from stdin (never argv, which would land it in shell
# history) and prints values ready to paste here. The password itself is
# never written anywhere.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. At least 32 characters; the app refuses to
# start a session with anything shorter. Generate with:
#
#   openssl rand -base64 48
#
# Changing it signs every administrator out immediately, which is the fastest
# way to revoke access.
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Notifications — email (Resend)
#
# Without these, booking notifications are written to the server log and the
# UI tells the guest to expect a phone call instead of claiming an email was
# sent. Nothing pretends to have delivered a message it did not.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you have verified with the provider.
NOTIFICATION_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Notifications — Telegram
#
# Both values are required together. Create a bot with @BotFather, then get
# the chat id by messaging the bot and reading:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# End-to-end tests (optional)
#
# `playwright.config.ts` provisions a throwaway admin account for the test
# run. Override it here if you prefer your own.
# -----------------------------------------------------------------------------
E2E_BASE_URL=
E2E_ADMIN_PASSWORD_HASH=
E2E_SESSION_SECRET=
